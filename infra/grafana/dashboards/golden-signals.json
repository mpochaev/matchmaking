{
  "uid": "matchmaking-golden-signals",
  "title": "Matchmaking Golden Signals",
  "schemaVersion": 41,
  "version": 1,
  "tags": [
    "matchmaking",
    "lab07"
  ],
  "timezone": "browser",
  "editable": true,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Запросы пользовательских маршрутов, в секунду",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job) (rate(http_server_requests_seconds_count{uri=~\"/api/.*|/internal/ratings/.*\"}[1m]))",
          "legendFormat": "{{job}}",
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "title": "Доля 5xx рейтинга, окно 1 минута",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "matchmaking:rating_error_ratio:rate1m",
          "legendFormat": "5xx / подходящие запросы",
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "title": "p95 успешных ответов рейтинга, окно 1 минута",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"rating-service\",method=\"GET\",uri=\"/internal/ratings/{playerId}\",status=\"200\"}[1m])))",
          "legendFormat": "p95",
          "range": true,
          "exemplar": true
        }
      ]
    },
    {
      "id": 4,
      "title": "Занятость JVM heap",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job) (jvm_memory_used_bytes{area=\"heap\"}) / sum by (job) (jvm_memory_max_bytes{area=\"heap\"} > 0)",
          "legendFormat": "{{job}}",
          "range": true
        }
      ]
    },
    {
      "id": 5,
      "title": "Прикладные результаты рейтинга",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (rate(rating_requests_total[1m]))",
          "legendFormat": "{{result}}",
          "range": true
        }
      ]
    },
    {
      "id": 6,
      "title": "Выполняющиеся расчёты рейтинга",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rating_active",
          "legendFormat": "{{job}}",
          "range": true
        }
      ]
    },
    {
      "id": 7,
      "title": "Ответ 200 не дольше 500 мс, окно 5 минут",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.995
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "matchmaking:rating_good_ratio:rate5m",
          "legendFormat": "SLI за 5 минут",
          "range": true
        }
      ]
    },
    {
      "id": 8,
      "title": "Доступность scrape targets",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"gateway-service|matchmaking-service|rating-service\"}",
          "legendFormat": "{{job}}",
          "range": true
        }
      ]
    },
    {
      "id": 9,
      "title": "Действия при сигнале",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 24,
        "h": 8
      },
      "options": {
        "mode": "markdown",
        "content": "### Runbook учебного стенда\n\n1. Уточните симптом: 5xx, задержка или недоступный scrape. Проверьте [targets](http://127.0.0.1:9090/targets), [правила](http://127.0.0.1:9090/rules) и [Alertmanager](http://localhost:9093).\n2. Через операторский endpoint узнайте диагностический режим. Если это ваш эксперимент, верните NORMAL. Режимы автоматически истекают не позднее 120 секунд.\n3. Найдите trace ID по exemplar либо в логах. Откройте Tempo, затем логи span в Loki; сравните сервис, trace ID и request ID.\n4. Проверьте восстановление ответов и очистку alert после выхода ошибок из минутного окна. Не перезапускайте процесс только из-за отказа downstream или scrape.\n\nSLI этой панели — учебное окно 5 минут; SLO 99,5% за 7 дней требует полной истории. Диагностические ошибки входят в измерение. Отсутствие трафика не означает 100% успеха. Внешние уведомления Alertmanager не настроены."
      }
    },
    {
      "id": 10,
      "title": "Ошибки рейтинга в структурных логах",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 37,
        "w": 24,
        "h": 8
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"matchmaking-apps\",service=\"rating-service\"} | json | outcome=\"failure\""
        }
      ]
    }
  ]
}
