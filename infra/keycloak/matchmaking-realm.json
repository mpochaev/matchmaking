{
  "realm": "matchmaking",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      {
        "name": "player"
      },
      {
        "name": "operator"
      },
      {
        "name": "service"
      }
    ]
  },
  "clients": [
    {
      "clientId": "matchmaking-bff",
      "protocol": "openid-connect",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "matchmaking-bff-secret",
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "redirectUris": ["http://localhost:8088/login/oauth2/code/keycloak", "http://localhost:18088/login/oauth2/code/keycloak"],
      "webOrigins": ["http://localhost:8088", "http://localhost:18088"],
      "defaultClientScopes": ["web-origins", "profile", "roles", "email"],
      "protocolMappers": [
        {
          "name": "aud-matchmaking",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "matchmaking-service",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "matchmaking-service-client",
      "protocol": "openid-connect",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "matchmaking-service-secret",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false,
      "defaultClientScopes": [
        "roles"
      ],
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "rating-service",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "matchmaking-ops-client",
      "protocol": "openid-connect",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "matchmaking-ops-secret",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false,
      "defaultClientScopes": [
        "roles"
      ],
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "rating-service",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "matchmaking-other-client",
      "protocol": "openid-connect",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "matchmaking-other-secret",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false,
      "defaultClientScopes": [
        "roles"
      ],
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "other-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "scopeMappings": [
    {
      "client": "matchmaking-bff",
      "roles": ["player", "operator"]
    },
    {
      "client": "matchmaking-service-client",
      "roles": [
        "service"
      ]
    },
    {
      "client": "matchmaking-ops-client",
      "roles": [
        "operator"
      ]
    },
    {
      "client": "matchmaking-other-client",
      "roles": [
        "service"
      ]
    }
  ],
  "users": [
    {
      "username": "player",
      "firstName": "Arena",
      "lastName": "Player",
      "enabled": true,
      "email": "player@example.test",
      "emailVerified": true,
      "credentials": [{"type": "password", "value": "player", "temporary": false}],
      "realmRoles": ["player"]
    },
    {
      "username": "operator",
      "firstName": "Arena",
      "lastName": "Operator",
      "enabled": true,
      "email": "operator@example.test",
      "emailVerified": true,
      "credentials": [{"type": "password", "value": "operator", "temporary": false}],
      "realmRoles": ["player", "operator"]
    },
    {
      "username": "service-account-matchmaking-service-client",
      "enabled": true,
      "serviceAccountClientId": "matchmaking-service-client",
      "realmRoles": [
        "service"
      ]
    },
    {
      "username": "service-account-matchmaking-ops-client",
      "enabled": true,
      "serviceAccountClientId": "matchmaking-ops-client",
      "realmRoles": [
        "operator"
      ]
    },
    {
      "username": "service-account-matchmaking-other-client",
      "enabled": true,
      "serviceAccountClientId": "matchmaking-other-client",
      "realmRoles": [
        "service"
      ]
    }
  ]
}
